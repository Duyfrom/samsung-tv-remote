{
  "name": "tv-remote",
  "productName": "TV Remote",
  "version": "1.0.0",
  "description": "Remote for 2016+ Samsung Tizen TVs: tray app with a Claude chat bar, plus an MCP server",
  "main": "src/main/main.js",
  "private": true,
  "license": "UNLICENSED",
  "author": "Khuong Duy Pham",
  "scripts": {
    "start": "electron .",
    "mcp": "node src/mcp/server.js",
    "test": "node --test test/*.test.js",
    "icons": "python3 scripts/make-icons.py",
    "dist": "electron-builder --win nsis --x64",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.khuongduypham.tvremote",
    "productName": "TV Remote",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "build/icon.png",
      "build/icon.ico",
      "build/tray*.png"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TV Remote",
      "artifactName": "TV-Remote-Setup-${version}.exe"
    },
    "copyright": "Copyright \u00a9 2026 Khuong Duy Pham"
  }
}
